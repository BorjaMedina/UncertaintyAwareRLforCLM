{
    "run_type": "staged_learning",
    "use_cuda": true,
    "tb_logdir": "tb_logdir",
    "json_out_config": "_staged_learning.json",
    "parameters": {
        "use_checkpoint": false,
        "summary_csv_prefix": "prefixCSV",
        "prior_file": "reinvent.prior",
        "agent_file": "reinvent.prior",
        "batch_size": 64,
        "unique_sequences": true,
        "randomize_smiles": true
    },
    "learning_strategy": {
        "type": "dap",
        "sigma": 120,
        "rate": 0.0001
    },
    "diversity_filter": {
        "type": "IdenticalMurckoScaffold",
        "bucket_size": 25,
        "minscore": 0,
        "minsimilarity": 0,
        "penalty_multiplier": 0.5
    },
    "stage": [
        {
            "chkpt_file": "chkpt_stage1",
            "termination": "simple",
            "max_score": 0.9,
            "min_steps": 2000,
            "max_steps": 2000,
            "scoring": {
                "type": "geometric_mean",
                "component":  [
                    {
                        "NoisyLogP": {
                          "endpoint": [
                            {
                              "name": "UncertaintyLogP",
                              "weight": 1,
                              "transform": {
                                  "type": "double_sigmoid",
                                  "high": 3.0,
                                  "low": 1.5,
                                  "coef_div": 60.0,
                                  "coef_si": 200.0,
                                  "coef_se": 200.0
                                  },
                              "params": {
                                "training_smiles": "trainingSmiles.txt",
                                "uq_parameters": [0.2, 0.8],
                                "uncertainty_type":"harshUnc_meanPostMPO",
                                "neighbours": 5
                              }
                            }
                          ]
                        }
                      },
                    {
                        "UNCdistances": {
                          "endpoint": [
                            {
                              "name": "Distances",
                              "weight": 0,
                              "params": {
                                "training_smiles": "trainingSmiles.txt",
                                "type": "tanimoto"
                              }
                            }
                          ]
                        }
                      },
                    {
                        "MolecularWeight": {
                            "endpoint": [
                                {
                                    "name": "MW",
                                    "weight": 1,
                                    "transform": {
                                        "type": "double_sigmoid",
                                        "high": 350.0,
                                        "low": 200.0,
                                        "coef_div": 900.0,
                                        "coef_si": 20.0,
                                        "coef_se": 20.0
                                        }
                                }
                            ]
                        }
                    },
                    {
                        "TPSA": {
                            "endpoint": [
                                {
                                    "name": "TPSA",
                                    "weight": 1,
                                    "transform": {
                                        "type": "double_sigmoid",
                                        "high": 90.0,
                                        "low": 40.0,
                                        "coef_div": 500.0,
                                        "coef_si": 20.0,
                                        "coef_se": 20.0
                                    }
                                }        
                            ]
                        }
                    }
                ]
            }
        }
    ]
}