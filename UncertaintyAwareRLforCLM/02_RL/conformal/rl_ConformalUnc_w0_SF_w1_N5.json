{
    "run_type": "staged_learning",
    "use_cuda": true,
    "tb_logdir": "./conformal/DISTw0_SFw1_N5Euc",
    "json_out_config": "_staged_learning.json",
    "parameters": {
        "use_checkpoint": false,
        "summary_csv_prefix": "./conformal/DISTw0_SFw1_N5Euc",
        "prior_file": "../../reinvent/priors/reinvent.prior",
        "agent_file": "../../reinvent/priors/reinvent.prior",
        "batch_size": 64,
        "unique_sequences": true,
        "randomize_smiles": true,
        "average": false
    },
    "learning_strategy": {
        "type": "dap",
        "sigma": 120,
        "rate": 0.0001
    },
    "diversity_filter": {
        "type": "IdenticalMurckoScaffold",
        "bucket_size": 25,
        "minscore": 0,
        "minsimilarity": 0,
        "penalty_multiplier": 0.5
    },
    "stage": [
        {
            "chkpt_file": "./conformal/DISTw0_SFw1_N5Euc",
            "termination": "simple",
            "max_score": 0.9,
            "min_steps": 10000,
            "max_steps": 10000,
            "scoring": {
                "type": "geometric_mean",
                "component":  [
                    {
                        "classificationCP": {
                        "endpoint": [
                            {
                            "name": "conformalPrediction",
                            "weight": 1,
                            "params": {
                                "training_smiles": "../00_data/egfr/egfr_smiles_2000.csv",
                                "model_path": "../01_cp/egfrFull_conformal.pkl",
                                "uncertainty_type": "CP"
                              }
                            }
                        ]
                        }
                    },
                    {
                        "uncclassificationCP": {
                        "endpoint": [
                            {
                            "name": "unc_CP",
                            "weight": 0,
                            "params": {
                                "training_smiles": "../00_data/egfr/egfr_smiles_2000.csv",
                                "model_path": "../01_cp/egfrFull_conformal.pkl",
                                "uncertainty_type": "CP"
                              }
                            }
                        ]
                        }
                      },
                    {
                        "UNCdistances": {
                          "endpoint": [
                            {
                              "name": "DistanceEGFR",
                              "weight": 0,
                              "params": {
                                "training_smiles": "../00_data/egfr/egfr_smiles_2000.csv",
                                "uncertainty_type": "tanimoto",
                                "neighbours": 5
                              }
                            }
                          ]
                        }
                      }, 
                    {
                        "MolecularWeight": {
                            "endpoint": [
                                {
                                    "name": "MW",
                                    "weight": 1,
                                    "transform": {
                                        "type": "double_sigmoid",
                                        "high": 650.0,
                                        "low": 400.0,
                                        "coef_div": 1000.0,
                                        "coef_si": 20.0,
                                        "coef_se": 20.0
                                        }
                                }
                            ]
                        }
                    },
                    {
                        "TPSA": {
                            "endpoint": [
                                {
                                    "name": "TPSA",
                                    "weight": 1,
                                    "transform": {
                                        "type": "double_sigmoid",
                                        "high": 100.0,
                                        "low": 80.0,
                                        "coef_div": 100.0,
                                        "coef_si": 25.0,
                                        "coef_se": 25.0
                                    }
                                }        
                            ]
                        }
                    }
                ]
            }
        }
    ]
}