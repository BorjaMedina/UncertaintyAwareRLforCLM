{
    "run_type": "staged_learning",
    "use_cuda": true,
    "tb_logdir": "./chempropUn8/ChempropUnc_w1_SF_w1_N5_Reward",
    "json_out_config": "_staged_learning.json",
    "parameters": {
        "use_checkpoint": false,
        "summary_csv_prefix": "./chempropUn8/ChempropUnc_w1_SF_w1_N5_Reward",
        "prior_file": "../../priors/reinvent.prior",
        "agent_file": "../../priors/reinvent.prior",
        "batch_size": 64,
        "unique_sequences": true,
        "randomize_smiles": true,
        "average": false
    },
    "learning_strategy": {
        "type": "dap",
        "sigma": 120,
        "rate": 0.0001
    },
    "diversity_filter": {
        "type": "IdenticalMurckoScaffold",
        "bucket_size": 25,
        "minscore": 0,
        "minsimilarity": 0,
        "penalty_multiplier": 0.5
    },
    "stage": [
        {
            "chkpt_file": "./chempropUn8/ChempropUnc_w1_SF_w1_N5_Reward",
            "termination": "simple",
            "max_score": 0.9,
            "min_steps": 10000,
            "max_steps": 10000,
            "scoring": {
                "type": "geometric_mean",
                "component":  [
                    {
                        "ExternalProcess": {
                        "endpoint": [
                            {
                            "name": "OracleEvaluator",
                            "weight": 0,
                            "params": {
                                "executable": "/home/$USER$/miniconda3/condabin/conda",
                                "args": "run -n chemprop python ../../reinvent_plugins/components/model_scoring_components/chemprop2_extProccessG.py ../01_chemprop/chemprop_model_mve_egfr_fullUn8",
                                "property": "predictions"
                            }
                            }
                        ]
                        }
                    },
                    {
                        "ExternalProcess": {
                        "endpoint": [
                            {
                            "name": "Chemprop",
                            "weight": 1,
                            "transform": {
                                "type": "sigmoid",
                                "high": 9.0,
                                "low": 3,
                                "k":0.18
                            },
                            "params": {
                                "executable": "/home/$USER$/miniconda3/condabin/conda",
                                "args": "run -n chemprop python ../../reinvent_plugins/components/model_scoring_components/chemprop2_extProccessG.py ../01_chemprop/chemprop_model_mve_egfr_supersmallUn8",
                                "property": "predictions"
                            }
                            }
                        ]
                        }
                    },
                    {
                        "ExternalProcess": {
                        "endpoint": [
                            {
                            "name": "uncertainty",
                            "weight": 1,
                            "params": {
                                "executable": "/home/$USER$/miniconda3/condabin/conda",
                                "args": "run -n chemprop python ../../reinvent_plugins/components/model_scoring_components/unc_chemprop2_extProccessG.py ../01_chemprop/chemprop_model_mve_egfr_supersmallUn8",
                                "property": "predictions",
                                "uncertainty_type": "reward_MVE"
                            }
                            }
                        ]
                        }
                    },
                    {
                        "UNCdistances": {
                          "endpoint": [
                            {
                              "name": "DistanceEGFR",
                              "weight": 0,
                              "params": {
                                "training_smiles": "../00_data/egfr/egfr_supersmall_smiles.csv",
                                "uncertainty_type": "tanimoto",
                                "neighbours": 5
                              }
                            }
                          ]
                        }
                      }, 
                    {
                        "MolecularWeight": {
                            "endpoint": [
                                {
                                    "name": "MW",
                                    "weight": 1,
                                    "transform": {
                                        "type": "double_sigmoid",
                                        "high": 650.0,
                                        "low": 400.0,
                                        "coef_div": 1000.0,
                                        "coef_si": 20.0,
                                        "coef_se": 20.0
                                        }
                                }
                            ]
                        }
                    },
                    {
                        "TPSA": {
                            "endpoint": [
                                {
                                    "name": "TPSA",
                                    "weight": 1,
                                    "transform": {
                                        "type": "double_sigmoid",
                                        "high": 100.0,
                                        "low": 80.0,
                                        "coef_div": 100.0,
                                        "coef_si": 25.0,
                                        "coef_se": 25.0
                                    }
                                }        
                            ]
                        }
                    }
                ]
            }
        }
    ]
}